{
    "layer": "bottom",
    "position": "bottom",
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,
    "modules-left": [
        "custom/l_end",
        "idle_inhibitor",
        "clock",
        "custom/r_end",
        "tray"
    ],
    "modules-center": [
        "sway/workspaces"
    ],
    "modules-right": [
        "custom/l_end",
        "group/system-level",
        "custom/pipe",
        "group/control-panel",
        "custom/r_end"
    ],
    "group/system-level": {
        "orientation": "horizontal",
        "modules": [
            "temperature",
            "custom/pipe",
            "memory",
            "custom/pipe",
            "custom/battery",
            "pulseaudio",
            "backlight"
        ]
    },
    "group/control-panel": {
        "orientation": "horizontal",
        "modules": [
            "custom/networkmanager"
        ]
    },
    "tray": {
        "icon-size": 18,
        "spacing": 5
    },
    "sway/workspaces": {
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": []
        },
        "format": "{icon}",
        "format-icons": {
            "focused": "",
            "default": "󰝣"
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰥔 ",
            "deactivated": " "
        }
    },
    "clock": {
        "format": "{:%H:%M %p}",
        "format-alt": "{:%R | 󰃭 %d·%m·%y}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#7832C8'><b>{}</b></span>",
                "weekdays": "<span color='#3278C8'><b>{}</b></span>",
                "today": "<span color='#C86432'><b>{}</b></span>"
            }
        }
    },
    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
        "critical-threshold": 85,
        "format": "CPU: {temperatureC}°C"
    },
    "memory": {
        "format": " {used:0.1f}/{total} ({percentage}%)",
        "tooltip-format": "SWAP: {swapUsed}/{swapTotal}",
        "interval": 3,
        "max-length": 20,
        "on-click": "foot -e htop",
        "critical-threshold": 80,
        "warning-threshold": 60
    },
    "custom/battery": {
        "exec": "~/.config/sway/scripts/battery-status.sh",
        "return-type": "json",
        "interval": 5,
        "format": "{}",
        "tooltip": true
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "on-scroll-up": "brightnessctl s 1%+",
        "on-scroll-down": "brightnessctl s 1%-"
    },
    "custom/networkmanager": {
        "exec": "~/.local/bin/menus/network-manager --status",
        "format": "{} ",
        "interval": 5,
        "on-click": "~/.local/bin/menus/network-manager",
        "tooltip": false
    },
    "custom/pipe": {
        "format": " | ",
        "tooltip": false
    },
    "custom/l_end": {
        "format": " ",
        "tooltip": false
    },
    "custom/r_end": {
        "format": " ",
        "tooltip": false
    }
}
