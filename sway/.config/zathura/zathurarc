set default-bg "#181818"
set default-fg "#E8E8E8"
set statusbar-bg "#202020"
set statusbar-fg "#E8E8E8"
set inputbar-bg "#202020"
set inputbar-fg "#E8E8E8"
set notification-bg "#202020"
set notification-fg "#E8E8E8"
set completion-bg "#202020"
set completion-fg "#B8B8B8"
set completion-highlight-bg "#E8E8E8"
set completion-highlight-fg "#181818"
set index-bg "#202020"
set index-fg "#B8B8B8"
set index-active-bg "#E8E8E8"
set index-active-fg "#181818"
set recolor true
set recolor-lightcolor "#E8E8E8"
set recolor-darkcolor "#181818"
set highlight-color "#E8E8E8"
set highlight-active-color "#FFFFFF"

set guioptions ""
set smooth-scroll true
set scroll-step 50
set adjust-open "best-fit"
set adjust-open-width true
set zoom-min 10
set zoom-max 1000
