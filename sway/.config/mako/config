# Layout & Position
anchor=top-right
margin=12
padding=12,16
width=360
height=120
border-size=2
border-radius=0

# Behaviour
max-visible=5
max-history=20
default-timeout=6000
ignore-timeout=0
sort=-time
layer=overlay

# Typography
font=0xProto Nerd Font 11

# Format
format=<b>%s</b>\n%b

# Monochrome — Default
background-color=#181818
text-color=#e8e8e8
border-color=#b8b8b8
progress-color=over #2a2a2a

# Urgency: Low
[urgency=low]
background-color=#181818
text-color=#7a7a7a
border-color=#3a3a3a
default-timeout=4000

# Urgency: Normal
[urgency=normal]
background-color=#181818
text-color=#e8e8e8
border-color=#b8b8b8
default-timeout=6000

# Urgency: Critical
[urgency=critical]
background-color=#181818
text-color=#ffffff
border-color=#ffffff
default-timeout=0

# Grouped notifications
[grouped]
format=(%g) <b>%s</b>\n%b
border-color=#d0d0d0

# Hidden overflow indicator
[hidden]
format=(%h more)
text-color=#7a7a7a
border-color=#3a3a3a

# Do Not Disturb mode
[mode=do-not-disturb]
invisible=1

# App-specific overrides
[app-name=notify-send urgency=low]
border-color=#5a5a5a

[urgency=normal app-name=dunst]
border-color=#d0d0d0
