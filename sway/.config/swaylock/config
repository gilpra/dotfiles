# Konfigurasi dasar
ignore-empty-password
font=0xProto Nerd Font Propo
font-size=40
clock
image=~/.wallpapers/bell_hydra.png
indicator-idle-visible

timestr=%H:%M

# Posisi dan ukuran indikator
indicator-radius=150
indicator-thickness=20
indicator-x-position=700
indicator-y-position=350

# Warna tema utama (Soft Charcoal Monochrome)
inside-color=181818CC
ring-color=B8B8B8CC
line-color=00000000
text-color=E8E8E8
separator-color=00000000

# Highlight tombol
key-hl-color=FFFFFF
bs-hl-color=7A7A7A

# Status: salah
inside-wrong-color=181818CC
line-wrong-color=FFFFFF
ring-wrong-color=FFFFFFCC
text-wrong-color=FFFFFF

# Status: verifikasi
inside-ver-color=181818CC
line-ver-color=B8B8B8
ring-ver-color=B8B8B8CC
text-ver-color=E8E8E8

# Status: clear
inside-clear-color=181818CC
line-clear-color=D0D0D0
ring-clear-color=D0D0D0CC
text-clear-color=D0D0D0

# Status: caps lock
inside-caps-lock-color=181818CC
line-caps-lock-color=F0F0F0
ring-caps-lock-color=F0F0F0CC
text-caps-lock-color=F0F0F0
caps-lock-bs-hl-color=7A7A7A
caps-lock-key-hl-color=F0F0F0

# Layout keyboard
layout-bg-color=181818CC
layout-border-color=00000000
layout-text-color=E8E8E8
