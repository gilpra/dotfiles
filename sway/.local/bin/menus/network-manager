#!/usr/bin/env bash

ON_COLOR="#e8e8e8"
OFF_COLOR="#8a8a8a"
SERVICE_OFF_COLOR="#4a4a4a"

ICON_OFF="󰖪"
ICON_ON="󱚼"

SIGNAL_ICONS=("󰤟" "󰤢" "󰤥" "󰤨")
SECURE_ICONS=("󰤡" "󰤤" "󰤧" "󰤪")

get_status() {
    local wifi_state info in_use signal security level

    wifi_state=$(nmcli -t -f WIFI g)

    if [[ "$wifi_state" != "enabled" ]]; then
        printf '<span color="%s">%s</span>\n' \
            "$SERVICE_OFF_COLOR" "$ICON_OFF"
        return
    fi

    info=$(nmcli -t -f IN-USE,SIGNAL,SECURITY device wifi |
        grep '^*' || true)

    if [[ -z "$info" ]]; then
        printf '<span color="%s">%s</span>\n' \
            "$OFF_COLOR" "$ICON_ON"
        return
    fi

    IFS=: read -r in_use signal security <<<"$info"

    level=$((signal / 25))
    ((level > 3)) && level=3

    if [[ "$security" =~ WPA|WEP ]]; then
        printf '<span color="%s">%s</span>\n' \
            "$ON_COLOR" "${SECURE_ICONS[$level]}"
    else
        printf '<span color="%s">%s</span>\n' \
            "$ON_COLOR" "${SIGNAL_ICONS[$level]}"
    fi
}

connect_wifi() {
    local ssid="$1"
    local pass

    [[ -z "$ssid" ]] && return

    if nmcli connection show | grep -Fq -- "$ssid"; then
        nmcli connection up "$ssid" &&
            notify-send "Wi-Fi" "Connected to $ssid"
        return
    fi

    while true; do
        pass=$(
            rofi -dmenu -password \
                -p "Password for $ssid:" \
                -theme ~/.config/rofi/input.rasi
        )

        if [[ -z "$pass" ]]; then
            notify-send "Wi-Fi" "Cancelled"
            return
        fi

        if nmcli device wifi connect "$ssid" password "$pass"; then
            notify-send "Wi-Fi" "Connected to $ssid"
            return
        fi

        notify-send "Wi-Fi" "Wrong password, try again"
        nmcli connection delete "$ssid" 2>/dev/null || true
    done
}

disconnect_wifi() {
    local current

    current=$(nmcli -t -f IN-USE,SSID device wifi |
        grep '^*' |
        cut -d: -f2)

    if [[ -n "$current" ]]; then
        nmcli connection down "$current" &&
            notify-send "Wi-Fi" "Disconnected"
    fi
}

forget_wifi() {
    local ssid

    ssid=$(
        nmcli -t -f NAME connection show |
            sort |
            rofi -dmenu \
                -p "Forget SSID:" \
                -theme ~/.config/rofi/menu.rasi
    )

    [[ -z "$ssid" ]] && return

    nmcli connection delete "$ssid" &&
        notify-send "Wi-Fi" "Forgot $ssid"
}

menu() {
    local wifi_state toggle command choice ssid

    wifi_state=$(nmcli -t -f WIFI g)

    toggle="Enable Service"
    command="on"

    if [[ "$wifi_state" == "enabled" ]]; then
        toggle="Disable Service"
        command="off"
    fi

    choice=$(
        printf '%s\n%s\n%s\n%s\n' \
            "$toggle" \
            "Connect" \
            "Disconnect" \
            "Forget" |
            rofi -dmenu \
                -p "Network:" \
                -theme ~/.config/rofi/menu.rasi
    )

    case "$choice" in
    "Enable Service" | "Disable Service")
        nmcli radio wifi "$command" &&
            notify-send "Wi-Fi Status" "Wi-Fi turned $command"
        ;;
    "Connect")
        nmcli device wifi rescan >/dev/null 2>&1 || true

        ssid=$(
            nmcli -t -f SSID device wifi list |
                awk 'NF' |
                sort -u |
                rofi -dmenu \
                    -p "SSID:" \
                    -theme ~/.config/rofi/menu.rasi
        )

        connect_wifi "$ssid"
        ;;
    "Disconnect")
        disconnect_wifi
        ;;
    "Forget")
        forget_wifi
        ;;
    esac
}

case "${1:-}" in
--status)
    get_status
    ;;
*)
    menu
    ;;
esac
