#!/usr/bin/env bash
set -Eeuo pipefail

if ! bluetoothctl show >/dev/null 2>&1; then
    notify-send 'Bluetooth' 'bluetoothd is unavailable'
    exit 1
fi

powered="$(bluetoothctl show | awk '/Powered:/ {print $2; exit}')"

if [[ "$powered" == 'yes' ]]; then
    toggle='Disable Bluetooth'
    cmd='power off'
else
    toggle='Enable Bluetooth'
    cmd='power on'
fi

choice=$(printf '%s\n%s\n' \
    "$toggle" \
    'Manage Bluetooth' |
    rofi -dmenu -p 'Bluetooth:' -theme "$HOME/.config/rofi/menu.rasi")

case "$choice" in
    "$toggle")
        bluetoothctl <<<"$cmd" >/dev/null
        notify-send 'Bluetooth' "Bluetooth $(awk '{print $2}' <<<"$cmd")"
        ;;
    'Manage Bluetooth')
        blueman-manager &
        ;;
esac
